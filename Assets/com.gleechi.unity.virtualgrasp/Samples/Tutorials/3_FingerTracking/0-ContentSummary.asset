--- !u!114 &-8993428119987489533
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Use the VG_CP_Oculus.OVRLib.Handtracking profile
  Text:
    m_Untranslated: "To pass this step, assign the proper controller profile to your
      avatar. \n\nIn <b>MyVirtualGrasp\u2192Avatars</b> select the avatar that you
      want to control by Oculus hand tracking.<br/>\nFind the <b>Profile</b> field
      of the <b>Primary Sensor Setup</b> and assign the VG_ControllerProfile <b>VG_CP_Oculus.OVRLib.Handtracking</b>
      to it (by just clicking the small circle on the right of the field)."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 8074200304209418783}
--- !u!114 &-7913134547688188571
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Use the VG_EC_USE_OCULUS_CONTROLLER scripting define symbol
  Text:
    m_Untranslated: "By enabling the scripting define symbol, the VG_EC_Oculus controller
      script was enabled. \n\nNote that the symbol was automatically added for Windows
      Standalone and Android, which are the platforms VG supports.\n\nIf you now
      receive errors on the console, find, read, and implement all requirements at
      the top the script file for your controller, for example <b>Rumtime / Scripts
      / VG_ExternalControllers / VG_EC_Oculus.cs</b> for Oculus hand tracking.\n\n<i>For
      example, for Oculus finger tracking you need the Oculus Integration plugin
      in your project, and the Oculus SDK on your computer.</i>"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 3958345800449445675}
--- !u!114 &-7385829928725561316
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
