--- !u!114 &6816171184891149222
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Each avatar can be configured through a scriptable <b>VG_ControllerProfile.
      </b>\n\nVirtualGrasp currently supports multiple controller profiles which
      you can find in <b>Runtime/Resources/VG_ControllerProfiles.</b> \n\nEach of
      these profiles is connected through one or more controller classes which can
      be found in <b>Runtime/Scripts/VG_ExternalControllers.</b>"
