  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'You have successfully setup a hand  tracking controller  to
      use your project with truly naturally grasps with VirtualGrasp.


      While
      this tutorial taught you how to use Oculus Quest''s hand tracking, you can
      follow the same process for any other  controller that VirtualGrasp supports.


      To
      finish this tutorial, you can now play your scene.'
