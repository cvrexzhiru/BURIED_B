  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Use the Grasp Baking Client to prepare your Upload
  Text:
    m_Untranslated: "To pass this step, create a bake package for upload. By default,
      it will be placed under <b>grasps.zip:</b>\n\nSelect <b>VirtualGrasp \u2192
      Bake Grasps</b> in the menu. \n\nIf this is your first time, enter the credentials
      that you have received when <a href=\"https://www.virtualgrasp.com/download\">registering
      for VirtualGrasp</a> in the <b>Login</b> tab and verify them.\n\nClick <b>Package</b>
      to create a <b>bake-job.zip</b> file from the content in your <b>vg_tmp</b>
      folder.\n\nIf you cannot continue, click <b>Export</b> once more to update
      the content in your <b>vg_tmp</b> folder.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 6657992827162969652}
