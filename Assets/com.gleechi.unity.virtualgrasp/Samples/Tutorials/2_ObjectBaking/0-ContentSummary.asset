  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Make the Interactable(s) Readable
  Text:
    m_Untranslated: "To pass this step, assure that at least the selected  object's
      model resource is readable.\n\nIt is tedious to do this manually for each single
      model by selecting the Mesh, selecting the resource in the Project View, checking
      the \"Read/Write\" in the Import Settings (under Model/Meshes), and applying
      the changes.\n\nThus, for your convenience, a menu function <b>VirtualGrasp
      \u2192 Make Interactables Readable</b> is provided to do this automatically
      for all objects that have a VG_Articulation assigned to them."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: -7741036374989934465}
