  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Select a GameObject with a VG_Articulation
  Text:
    m_Untranslated: To pass this step, select a GameObject that contains a VG_Articulation
      component. <br/> If you don't have one in your scene, build it by assigning
      a VG_Articulation to an existing object, or by importing an object into your
      scene  first.<br/> Note that you do not need to setup colliders or rigid bodies
      to make the object interactable.
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 4825600947318149417}
