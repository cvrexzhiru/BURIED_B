  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Use the Baking Client to Bake your Objects
  Text:
    m_Untranslated: "To pass this step, create a bake that downloads your interaction
      model. \n\nBy default, the output will be saved in your  <b>Assets/VG_Grasps</b>
      folder. \n\nClick <b>Create grasps for project</b> in the baking client window.\n\nNote
      that after a bake, the <b>Create grasps for project</b> will be grayed out.
      You have to prepare the project for a new bake request."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 552787932914246925}
