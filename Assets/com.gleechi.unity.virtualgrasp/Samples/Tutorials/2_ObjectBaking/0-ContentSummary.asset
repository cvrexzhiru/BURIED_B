  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Export Geometrical Data for your Objects
  Text:
    m_Untranslated: "To pass this step, create a <b>grasps.zip</b> package: <br/>
      Select the GameObject that contains your VG_MainScript component. <br/> Open
      the <b>MyVirtualGrasp\u2192Debug Settings</b> section and enable <b>Export
      scene in Runtime. Start and Stop</b> the scene once.\n\nAlternatively, you
      can click <b>Export Scene in Editor,</b> but be aware that objects that do
      not exist in your offline scene, but only in runtime (such as dynamically spawned
      objects), will not be considered."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: -5998554414570516572}
