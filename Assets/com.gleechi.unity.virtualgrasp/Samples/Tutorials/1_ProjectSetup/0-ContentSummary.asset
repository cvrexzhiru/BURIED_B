  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Configure your controller
  Text:
    m_Untranslated: 'Use the <b>Profile</b> slot to select a controller profile of
      the controller you would like to use.


      We recommend to use the <b>VG_CP_Unity.UnityXR</b>
      controller if you have XR Management enabled in your project.


      Many
      other controllers have dependencies on third-party plugins, so if you are just
      getting started, we recommend <b>VG_CP_Unity.UnityXR</b> for XR scenes and
      <b>VG_CP_Common.Mouse</b> for non-XR scenes.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 5129894891768847694}
