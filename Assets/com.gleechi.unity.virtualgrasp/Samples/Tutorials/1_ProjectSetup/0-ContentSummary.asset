  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: In this tutorial, you will go through the minimal steps to enable
      VirtualGrasp in your project.<br/> The tutorial can be used to either setup
      a new project with VirtualGrasp or to check that your project is already properly
      setup.<br/> Lets's get started!
--- !u!114 &-4192914271536253701
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
