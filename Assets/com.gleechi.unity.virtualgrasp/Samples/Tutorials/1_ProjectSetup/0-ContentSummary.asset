  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Select the MyVirtualGrasp component
  Text:
    m_Untranslated: To pass this step, select the GameObject that contains the <b>MyVirtualGrasp</b>
      component in the Hierarchy view. <br/> There can only be one such script in
      the whole scene.<br/> If there is no such script, add a <b>MyVirtualGrasp</b>
      component to a GameObject (using "Add Component") and select that GameObject
      in the Hierarchy to continue.
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: -779093988609098514}
