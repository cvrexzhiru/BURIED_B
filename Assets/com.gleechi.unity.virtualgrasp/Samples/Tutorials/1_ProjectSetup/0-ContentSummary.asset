  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Assign a  SkinnedMeshRender
  Text:
    m_Untranslated: In the <b>MyVirtualGrasp</b> component, you can find a list of
      Avatars.<br/> If the list is empty, add an Avatar. Then, assign the SkinnedMeshRenderer
      of your avatar to the <b>SkeletalMesh</b> slot to continue. You can do this
      easiest by clicking the small circle icon to the right of <b>SkeletalMesh</b>
      and selecting for example <b>GleechiHandMesh</b> (in case you imported the
      GleechiRig in the previous step).
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.ArbitraryCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: 4907991074283103332}
